<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>Content - BSL Daily Content</name>
    <author>Vasilyev Alexander</author>
    <creationDate>2026-10-23</creationDate>
    <copyright>Copyright (C) 2026 Vasilyev Alexander. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>soft@BSL-World.ru</authorEmail>
    <authorUrl>https://bsl-world.ru</authorUrl>
    <version>1.3.1</version>
    <description>PLG_CONTENT_BSLDAILYCONTENT_XML_DESCRIPTION</description>
    <namespace path="src">BSLWorld\Plugin\Content\Bsldailycontent</namespace>
    <scriptfile>script.php</scriptfile>
    <changelogurl>https://bsl-world.ru/downloads/bsl-daily-content/changelog.xml</changelogurl>
    <files>
        <filename>LICENSE.txt</filename>
        <filename>script.php</filename>
        <folder plugin="bsldailycontent">services</folder>
        <folder>src</folder>
    </files>
    <languages folder="language">
        <language tag="en-GB">en-GB/plg_content_bsldailycontent.ini</language>
        <language tag="en-GB">en-GB/plg_content_bsldailycontent.sys.ini</language>
        <language tag="ru-RU">ru-RU/plg_content_bsldailycontent.ini</language>
        <language tag="ru-RU">ru-RU/plg_content_bsldailycontent.sys.ini</language>
    </languages>
    <media destination="plg_content_bsldailycontent" folder="media">
        <folder>css</folder>
        <folder>js</folder>
    </media>
    <config>
        <fields name="params">
            <fieldset
                name="setup"
                label="PLG_CONTENT_BSLDAILYCONTENT_FIELDSET_SETUP_LABEL"
                addfieldprefix="BSLWorld\Plugin\Content\Bsldailycontent\Field"
            >
                <field
                    name="setup"
                    type="setup"
                    label="PLG_CONTENT_BSLDAILYCONTENT_SETUP_LABEL"
                />
                <field
                    name="date_field_id"
                    type="hidden"
                    default="0"
                    validate="setup"
                    addruleprefix="BSLWorld\Plugin\Content\Bsldailycontent\Rule"
                />
            </fieldset>
            <fieldset
                name="primary"
                label="PLG_CONTENT_BSLDAILYCONTENT_FIELDSET_PRIMARY_LABEL"
            >
                <field
                    name="primary_language"
                    type="contentlanguage"
                    required="true"
                    label="PLG_CONTENT_BSLDAILYCONTENT_PRIMARY_LANGUAGE_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_PRIMARY_LANGUAGE_DESC"
                >
                    <option value="">JSELECT</option>
                </field>
                <field
                    name="primary_category_id"
                    type="category"
                    extension="com_content"
                    published="1"
                    default="0"
                    required="true"
                    label="PLG_CONTENT_BSLDAILYCONTENT_PRIMARY_CATEGORY_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_PRIMARY_CATEGORY_DESC"
                >
                    <option value="">JSELECT</option>
                </field>
                <field
                    name="primary_full_page_item_id"
                    type="menuitem"
                    client_id="0"
                    published="1"
                    default="0"
                    required="false"
                    label="PLG_CONTENT_BSLDAILYCONTENT_PRIMARY_FULL_PAGE_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_PRIMARY_FULL_PAGE_DESC"
                >
                    <option value="">JSELECT</option>
                </field>
            </fieldset>
            <fieldset
                name="secondary"
                label="PLG_CONTENT_BSLDAILYCONTENT_FIELDSET_SECONDARY_LABEL"
            >
                <field
                    name="secondary_language"
                    type="contentlanguage"
                    required="false"
                    label="PLG_CONTENT_BSLDAILYCONTENT_SECONDARY_LANGUAGE_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_SECONDARY_LANGUAGE_DESC"
                >
                    <option value="">JSELECT</option>
                </field>
                <field
                    name="secondary_category_id"
                    type="category"
                    extension="com_content"
                    published="1"
                    default="0"
                    required="false"
                    label="PLG_CONTENT_BSLDAILYCONTENT_SECONDARY_CATEGORY_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_SECONDARY_CATEGORY_DESC"
                >
                    <option value="">JSELECT</option>
                </field>
                <field
                    name="secondary_full_page_item_id"
                    type="menuitem"
                    client_id="0"
                    published="1"
                    default="0"
                    required="false"
                    label="PLG_CONTENT_BSLDAILYCONTENT_SECONDARY_FULL_PAGE_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_SECONDARY_FULL_PAGE_DESC"
                >
                    <option value="">JSELECT</option>
                </field>
            </fieldset>
            <fieldset
                name="appearance"
                label="PLG_CONTENT_BSLDAILYCONTENT_FIELDSET_APPEARANCE_LABEL"
                addfieldprefix="BSLWorld\Plugin\Content\Bsldailycontent\Field"
            >
                <field
                    name="accent_color_source"
                    type="list"
                    default="h1"
                    filter="cmd"
                    label="PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_SOURCE_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_SOURCE_DESC"
                >
                    <option value="h1">PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_H1</option>
                    <option value="h2">PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_H2</option>
                    <option value="h3">PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_H3</option>
                    <option value="h4">PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_H4</option>
                    <option value="h5">PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_H5</option>
                    <option value="h6">PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_H6</option>
                    <option value="navigation">PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_NAVIGATION</option>
                    <option value="links">PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_LINKS</option>
                    <option value="custom">PLG_CONTENT_BSLDAILYCONTENT_ACCENT_COLOR_CUSTOM</option>
                </field>
                <field
                    name="custom_accent_color"
                    type="color"
                    default="#0d6efd"
                    format="hex"
                    showon="accent_color_source:custom"
                    label="PLG_CONTENT_BSLDAILYCONTENT_CUSTOM_ACCENT_COLOR_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_CUSTOM_ACCENT_COLOR_DESC"
                />
                <field
                    name="calendar_background_opacity"
                    type="opacity"
                    min="0"
                    max="100"
                    step="5"
                    default="75"
                    filter="integer"
                    label="PLG_CONTENT_BSLDAILYCONTENT_CALENDAR_BACKGROUND_OPACITY_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_CALENDAR_BACKGROUND_OPACITY_DESC"
                />
                <field
                    name="calendar_font_size"
                    type="list"
                    default="medium"
                    filter="cmd"
                    label="PLG_CONTENT_BSLDAILYCONTENT_CALENDAR_SIZE_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_CALENDAR_SIZE_DESC"
                >
                    <option value="small">PLG_CONTENT_BSLDAILYCONTENT_CALENDAR_SIZE_SMALL</option>
                    <option value="medium">PLG_CONTENT_BSLDAILYCONTENT_CALENDAR_SIZE_MEDIUM</option>
                    <option value="large">PLG_CONTENT_BSLDAILYCONTENT_CALENDAR_SIZE_LARGE</option>
                </field>
                <field
                    name="calendar_bold"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    default="0"
                    filter="integer"
                    label="PLG_CONTENT_BSLDAILYCONTENT_CALENDAR_BOLD_LABEL"
                    description="PLG_CONTENT_BSLDAILYCONTENT_CALENDAR_BOLD_DESC"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server
            type="extension"
            priority="1"
            name="BSL Daily Content Updates"
        >https://bsl-world.ru/downloads/bsl-daily-content/updates.xml</server>
    </updateservers>
</extension>
